{
  "expo": {
    "name": "mega-project",
    "slug": "mega-project",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "megaproject",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      ["expo-font",
    {"fonts": [
      "./assets/fonts/Roboto/static/Roboto-Regular.ttf",
      "./assets/fonts/Roboto/static/Roboto-Medium.ttf",
      "./assets/fonts/Roboto/static/Roboto-Bold.ttf",
      "./assets/fonts/Roboto/static/Roboto-SemiBold.ttf",
      "./assets/fonts/Roboto/static/Roboto-Italic.ttf",
      "./assets/fonts/Roboto/static/Roboto-MediumItalic.ttf",
      "./assets/fonts/Roboto/static/Roboto-BoldItalic.ttf",
      "./assets/fonts/Roboto/static/Roboto-Light.ttf",
      "./assets/fonts/Roboto/static/Roboto-LightItalic.ttf"

    ]}]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
